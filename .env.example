# Local docker-compose env. Copy to .env and fill in every value —
# compose fails fast if POSTGRES_PASSWORD or AUTH_SECRET are unset.
POSTGRES_USER=tracker
POSTGRES_PASSWORD=
POSTGRES_DB=inventory_tracker
# 32+ random chars. Generate: openssl rand -hex 32
AUTH_SECRET=
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:8080
DEFAULT_CURRENCY=USD
DEFAULT_TIMEZONE=UTC
# First local boot: creates the business + owner (remove password after login).
BOOTSTRAP_BUSINESS_NAME=My Shop
BOOTSTRAP_OWNER_NAME=Owner
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_PASSWORD=
SEED_DEMO=false
SEED_DEMO_PASSWORD=
ALLOW_DEMO_LOGIN=false
MAX_UPLOAD_MB=5
