# Public build-time config. Changing any value requires a redeploy.
# Never put secrets in VITE_* variables — they ship to every browser.
VITE_API_URL=https://your-api.onrender.com
VITE_APP_NAME=Inventory Tracker
# Local dev only: Vite proxy target for /api (never used in production builds).
VITE_DEV_API_TARGET=http://localhost:4000
