# Frontend env. Local dev reads .env (Vite); Cloudflare Pages takes the same
# keys from its dashboard (Settings → Environment variables) at BUILD time —
# changing VITE_API_URL requires a rebuild to take effect.
#
# Production (Cloudflare): set VITE_API_URL to the Render backend origin.
# Local dev: leave VITE_API_URL empty and use VITE_DEV_API_TARGET (the Vite
# proxy forwards /api there, avoiding CORS entirely).
VITE_API_URL=
VITE_DEV_API_TARGET=http://localhost:4000
