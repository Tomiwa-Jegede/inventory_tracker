# Backend env. Copy to .env for local dev (never commit .env).
# In production (Render) set these in the dashboard instead.

NODE_ENV=development
PORT=4000

# App uses the POOLED Neon URL; migrations use the DIRECT (unpooled) URL.
DATABASE_URL=postgres://user:pass@localhost:5432/inventory_tracker
DATABASE_URL_UNPOOLED=postgres://user:pass@localhost:5432/inventory_tracker
DB_POOL_MAX=10

# 32+ random chars. Generate: openssl rand -hex 32
AUTH_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_EXPIRES_IN=7d

# Comma-separated frontend origin(s). Required in production.
CORS_ORIGINS=http://localhost:5173

# Defaults for NEW businesses (ISO currency code + IANA timezone).
DEFAULT_CURRENCY=USD
DEFAULT_TIMEZONE=UTC

# First-deploy bootstrap: creates the first business + owner if no users
# exist. Remove BOOTSTRAP_OWNER_PASSWORD after first login.
BOOTSTRAP_BUSINESS_NAME=
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=

# Demo seed (dev/staging only, never production). Requires a password so
# seeded users can actually log in.
SEED_DEMO=false
SEED_DEMO_PASSWORD=
# Legacy kill-switch. Must stay false; production refuses to boot with true.
ALLOW_DEMO_LOGIN=false

MAX_UPLOAD_MB=5
JSON_BODY_LIMIT=1mb

# Receipt storage (Cloudflare R2). Required in production; local disk is used
# when unset (dev only — Render disks are ephemeral).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Only for public-bucket setups; private buckets use signed URLs instead.
R2_PUBLIC_BASE_URL=
